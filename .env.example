# Environment variables for `docker compose up`.
#
# Copy this file to `.env` in the repository root and you can run the whole
# stack (Postgres/PostGIS, RabbitMQ, Celery, Gunicorn, Nginx) with no other
# setup:
#
#   $ cp .env.example .env
#   $ docker compose up --build
#
# Every value below is a safe placeholder, not a real credential, so the
# stack comes up and the site loads as-is. SMS/email alerts won't actually
# send until you replace the EMAIL_* / TWILIO_* placeholders with real
# credentials (see the links above each section).

# Django secret key. Fine for local/demo use; generate a real random value
# before exposing this to the internet.
SECRET_KEY=change-this-key-before-any-real-deployment

# Model values
LAT_VALUE=-80.5
LON_VALUE=175
INITIAL_BACKTIME=5
OPEN_METEO_FORECAST_DAYS=2
OPEN_METEO_ENSEMBLE_MEMBERS=2
MODEL_TIMESTEP=0.25

# OpenStreetMap tile URL (free, no API key needed)
MAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# When using Gmail, create an app password via https://myaccount.google.com/apppasswords
# Alerts silently fail to send until these are set to real values.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=emailAddressOrUserName
EMAIL_HOST_PASSWORD=emailAccountPassword
EMAIL_USE_SSL=True

# https://console.twilio.com/
# SMS alerts silently fail to send until these are set to real values.
TWILIO_ACCOUNT_SID=twilioAccontSID
TWILIO_AUTH_TOKEN=twilioAuthToken
TWILIO_PHONE_NUMBER=twilioPhoneNumber
TWILIO_VERIFICATION_SID=twilioVerificationServiceId

# Postgres database credentials (read by both the postgres container and Django)
DB_NAME=manyfews
DB_USER=manyfews
DB_PASSWORD=manyfews
DB_HOST=postgres
DB_PORT=5432

# RabbitMQ (Celery task broker)
RABBITMQ_DEFAULT_USER=manyfews
RABBITMQ_DEFAULT_PASS=manyfews
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Docker compose project name (used as a prefix for container names)
COMPOSE_PROJECT_NAME=manyfews

# Other: set these if accessing on a host:port other than localhost:80
ALLOWED_HOSTS=127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://web:80
DEBUG=True
